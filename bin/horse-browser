#!/usr/bin/env bash
# horse-browser — start the dedicated agent browser, and optionally drive it.
#
# Two modes, chosen automatically from stdin:
#   • bare    `horse-browser`             → ensure the browser is up (+ self-heal), exit.
#   • driver  `horse-browser <<'PY' … PY` → ensure it's up, then run the script through
#             browser-harness against it. A drop-in for `browser-harness` that always
#             pre-flights the browser first. Args forward too, e.g. `horse-browser --doctor`.
#
# Driver mode sets BU_CDP_URL itself, so the CDP port is owned entirely by this tool —
# callers never hardcode it. Change PORT in the config and the whole fleet follows.
#
# Subcommands:
#   horse-browser status   versions (chrome / browser-harness / horse-browser) + state
#   horse-browser update   fetch the latest Chrome for Testing and restart onto it
#
# Idempotent. Config is written by install.sh to ~/.config/horse-browser/config.
# Env vars override it: HORSE_BROWSER_BIN, HORSE_BROWSER_PORT, HORSE_BROWSER_PROFILE,
# HORSE_BROWSER_EXTENSION.
set -euo pipefail

CONFIG="$HOME/.config/horse-browser/config"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

PORT="${HORSE_BROWSER_PORT:-${PORT:-9223}}"
PROFILE="${HORSE_BROWSER_PROFILE:-${PROFILE:-$HOME/.config/horse-browser/profile}}"
BIN="${HORSE_BROWSER_BIN:-${BROWSER_BIN:-}}"
EXT="${HORSE_BROWSER_EXTENSION:-${EXTENSION_DIR:-}}"
CACHE="${HORSE_BROWSER_CACHE:-$HOME/.cache/horse-browser}"

# Repo/package root (resolves the launcher symlink) — integrations/ lives here.
# npm's bin symlink is RELATIVE (../lib/node_modules/…), so resolve it against the
# symlink's own directory, not the caller's cwd.
SELF="$0"
if [ -L "$SELF" ]; then
  _target="$(readlink "$SELF")"
  case "$_target" in
    /*) SELF="$_target" ;;
    *)  SELF="$(dirname "$SELF")/$_target" ;;
  esac
fi
ROOT="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || true)"

# The extension ships with this package — fall back to it when the config predates
# EXTENSION_DIR or points at a folder that no longer exists (a fresh install must
# never come up without the tab grouper + look-and-feel seeding).
if { [ -z "$EXT" ] || [ ! -d "$EXT" ]; } && [ -n "$ROOT" ] && [ -d "$ROOT/extension" ]; then
  EXT="$ROOT/extension"
fi

# ── vendored harness: the CDP daemon + helpers that drive the browser ─────────
# horse-harness (harness/horse_harness) is the vendored browser-harness core with
# the shared-browser invariants baked into the daemon. It runs from a private venv
# inside the package; postinstall creates it, and this self-heals a missing one
# (e.g. after an npm update wiped the package dir).
HARNESS_DIR="$ROOT/harness"
HARNESS_PY="$HARNESS_DIR/.venv/bin/python3"
ensure_harness() {
  [ -n "$ROOT" ] && [ -d "$HARNESS_DIR/horse_harness" ] || {
    echo "horse-browser: $HARNESS_DIR/horse_harness missing — reinstall the package (npm i -g @pa1nd/horse-browser or ./install.sh)" >&2
    return 1
  }
  if [ ! -x "$HARNESS_PY" ]; then
    echo "horse-browser: setting up the harness venv (one-time)…" >&2
    # A non-login shell (an npm postinstall over ssh, cron) often has a bare PATH that misses
    # Homebrew / cargo, so `command -v uv` fails even when uv IS installed, and the stock
    # /usr/bin/python3 can be too old — the build then wrongly bails "need uv or python3 ≥3.11".
    # Every npm update wipes this venv (it lives in the package dir), so add the usual tool dirs
    # first, letting the rebuild self-heal without a login shell.
    for _d in /opt/homebrew/bin /usr/local/bin "$HOME/.cargo/bin" "$HOME/.local/bin"; do
      [ -d "$_d" ] && case ":$PATH:" in *":$_d:"*) ;; *) PATH="$_d:$PATH" ;; esac
    done
    if command -v uv >/dev/null 2>&1; then
      uv venv --quiet --python 3.12 "$HARNESS_DIR/.venv" \
        && uv pip install --quiet --python "$HARNESS_PY" 'cdp-use==1.4.5' 'websockets==15.0.1'
    elif command -v python3 >/dev/null 2>&1 \
        && python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
      python3 -m venv "$HARNESS_DIR/.venv" \
        && "$HARNESS_PY" -m pip install --quiet 'cdp-use==1.4.5' 'websockets==15.0.1'
    fi
    [ -x "$HARNESS_PY" ] || {
      echo "horse-browser: harness venv setup failed — need uv (https://docs.astral.sh/uv) or python3 ≥3.11" >&2
      return 1
    }
  fi
  # The package is imported from the package dir, not installed into the venv, so
  # an npm update swaps the code in place with no reinstall step.
  export PYTHONPATH="$HARNESS_DIR${PYTHONPATH:+:$PYTHONPATH}"
}

# ── --lane: harness-internal sub-identity ─────────────────────────────────────
# Splits one agent session into isolated lanes (own daemon, own tab group) so
# parallel agents sharing an env never clobber each other. Agents never pass it
# themselves — an integration (e.g. the claude-code PreToolUse hook) injects it.
# Stripped here, BEFORE mode/subcommand handling, so it composes with anything.
LANE="${HORSE_LANE:-}"
_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --lane)   shift; LANE="${1:-}" ;;
    --lane=*) LANE="${1#--lane=}" ;;
    *)        _args+=("$1") ;;
  esac
  shift
done
set -- ${_args[@]+"${_args[@]}"}
case "$LANE" in *[!A-Za-z0-9_-]*|"") LANE="" ;; esac   # sane token or nothing

# Capture a script ONLY when stdin can deliver one without blocking forever:
#   • regular file (-f: heredoc on macOS bash, `< file`) — always reaches EOF.
#   • FIFO / socket (-p/-S: shell pipes, Node/libuv socketpairs, ssh channels) — a
#     piped script's data is already in flight when we get here, but an *idle* held
#     pipe never EOFs (bare `ssh host horse-browser` with stdin kept open, bare Node
#     spawn) — so peek first: read to EOF only if a byte arrives within a beat;
#     silence falls through to bare mode instead of hanging.
# A bare invocation's stdin is otherwise a tty or /dev/null — never read, never hang.
script=""
if [ -f /dev/fd/0 ]; then
  script="$(cat)"
elif [ -p /dev/fd/0 ] || [ -S /dev/fd/0 ]; then
  script="$(python3 -c '
import select, sys
if select.select([sys.stdin], [], [], 1.0)[0]:
    sys.stdout.write(sys.stdin.read())
' 2>/dev/null || true)"
fi
# Driver mode = a script on stdin OR args to forward to browser-harness.
PASSTHROUGH=
if [ -n "$script" ] || [ "$#" -gt 0 ]; then PASSTHROUGH=1; fi

# Pre-flight info goes to stdout in bare mode, but to stderr in driver mode so the
# script's stdout stays pure browser-harness output.
say() { if [ -n "$PASSTHROUGH" ]; then echo "$@" >&2; else echo "$@"; fi; }

cdp_up() { curl -sf "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }

# require_macos: the launcher OWNS a browser, and every mechanism it owns one with is a macOS
# mechanism — focus-free launch via `open -g -n`, the GPU-wedge heal, CGDisplayIsAsleep, the
# lock's stat(1) flags. package.json gates npm to darwin, but a --force install (or a copied
# checkout) gets past that and would otherwise discover all this as a 30-second CDP timeout.
# Say it once, plainly, at the two entry points that touch a browser. The vendored HARNESS is
# portable — its unit suite passes on Linux — so the honest fallback is to point it at a
# browser you launched yourself; that is what the message offers.
require_macos() {
  [ "$(uname -s)" = "Darwin" ] && return 0
  if [ -n "${HORSE_BROWSER_ALLOW_UNSUPPORTED_OS:-}" ]; then
    say "horse-browser: unsupported OS ($(uname -s)) — continuing anyway (HORSE_BROWSER_ALLOW_UNSUPPORTED_OS). Launch, heal and display handling are macOS-shaped; expect them to misbehave."
    return 0
  fi
  cat >&2 <<EOF
horse-browser: macOS only — this machine is $(uname -s).
  The launcher's job is owning a browser (focus-free launch, GPU heal, display state), and
  each of those is a macOS mechanism. Chrome for Testing also ships no linux-arm64 build.
  The vendored harness itself IS portable — drive a browser you launched yourself:
      <your chrome> --remote-debugging-port=9223 --user-data-dir=/some/profile &
      BU_CDP_URL=http://127.0.0.1:9223 python3 -m horse_harness.run <<'PY'
      print(page_info())
      PY
  To push past this guard anyway: HORSE_BROWSER_ALLOW_UNSUPPORTED_OS=1 horse-browser …
EOF
  return 1
}

# ── self-heal: GPU-process wedge after macOS sleep/wake ──────────────────────
# After the machine or an external display sleeps, Chrome for Testing's GPU process
# can get stuck in the frame-present path and never re-acquire its window-server
# surface on wake. The renderer keeps running — JS, timers, non-render CDP all work —
# but NOTHING paints: the window is frozen and Page.captureScreenshot hangs forever.
# Stable Chrome/Brave auto-recover via a Finch seed + GPU watchdog; Chrome for Testing
# (Null variations seed) does not, so the wedge is permanent until the GPU process is
# restarted. RECOVERY (proven, non-destructive — no tabs/data lost): kill ONLY this
# profile's GPU child; Chrome respawns it and the compositor rebuilds. So every
# `horse-browser` invocation probes paint and heals a frozen browser automatically.
#
# ESCALATION: Chrome counts our kills as GPU crashes — ~3 in quick succession (e.g.
# several sessions healing concurrently after wake) make it fall back to software GL
# (--use-gl=disabled) for the rest of the session. That state still paints, so
# gpu_healthy passes, but the software compositor pins a CPU core (observed
# 2026-07-11: Activity Monitor energy impact ~7,500). So: never kill twice within
# the backoff window, detect the fallback state on every invocation, and in both
# cases escalate to a full quit + relaunch (tabs preserved) — the only thing that
# restores hardware GL.

# Stamp of the last GPU-process kill, for the backoff above. Keyed to the profile, like
# HB_LOCK below: the backoff is about ONE browser's crash count, so a sibling instance's
# heal must not make us skip our own kill (or escalate to a needless relaunch).
# Adopt the pre-0.9.7 global stamp once, so an upgrade landing inside the backoff window
# still sees the kill that just happened instead of stacking a second one.
HEAL_STAMP="${PROFILE%/}.last-heal"
HEAL_STAMP_LEGACY="$HOME/.config/horse-browser/.last-heal"   # pre-0.9.7, global; read-only now

# heal_log <event> [k=v …]: one tab-separated line per incident, with enough context
# (time since wake, process ages, trigger details) to understand over time WHY the
# wedge/fallback fires — not just that it did. Read it: ~/.config/horse-browser/heal.log
heal_log() {
  local event="$1"; shift || true
  local log="${HORSE_BROWSER_HEAL_LOG:-$HOME/.config/horse-browser/heal.log}"
  mkdir -p "$(dirname "$log")" 2>/dev/null || true
  local now wake since_wake="?"
  now=$(date +%s)
  wake=$(sysctl -n kern.waketime 2>/dev/null | sed -n 's/.*{ sec = \([0-9]*\).*/\1/p')
  [ -n "$wake" ] && since_wake="$(( now - wake ))s"
  printf '%s\t%s\tsince_wake=%s\t%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$event" "$since_wake" "$*" >> "$log" 2>/dev/null || true
}

# focus_breadcrumb: append a launcher event to the focus log, so `focus-watch` shows browser
# launches/relaunches in the same timeline as any macOS focus steal — makes it obvious when a
# steal was caused by a (re)launch (the window appearing, the welcome page, session-restore).
focus_breadcrumb() {
  local log="${HORSE_BROWSER_FOCUS_LOG:-$HOME/.config/horse-browser/focus.log}"
  mkdir -p "$(dirname "$log")" 2>/dev/null || true
  printf '%s  [launcher] %s  session=%s pid=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S.000')" "$*" "${HORSE_SESSION:-?}" "$$" >> "$log" 2>/dev/null || true
}

# ── single-flight lock: at most one invocation mutates the browser at a time ──
# Guards every mutation — cold launch, GPU heal, relaunch, update's restart — so
# concurrent sessions never kill/launch/seed over each other. Measured failure modes
# without it: a second cold launcher's gate kill -9s the browser the first just
# started; two healers stack GPU kills and trip Chrome's crash-count into software
# GL. Losers don't touch processes at all: they wait for the holder and then trust
# CDP state. Re-entrant within one process (relaunch → ensure_browser → launch) via
# a depth counter; crash-safe across processes via the holder pid — a dead holder's
# lock is broken immediately, so no EXIT traps needed (exec wouldn't run them anyway).
# Per-BROWSER-INSTANCE, keyed to the profile (--user-data-dir): the single-flight guard is about
# one browser, so an isolated instance on its own profile (e.g. a test run) never contends with
# the live browser's lock. The default profile keeps the legacy path so existing installs don't churn.
if [ "$PROFILE" = "$HOME/.config/horse-browser/profile" ]; then
  HB_LOCK="$HOME/.config/horse-browser/.browser-lock"
else
  HB_LOCK="${PROFILE%/}.browser-lock"
fi
HB_LOCK_DEPTH=0
hb_lock() {
  if [ "$HB_LOCK_DEPTH" -gt 0 ]; then HB_LOCK_DEPTH=$((HB_LOCK_DEPTH + 1)); return 0; fi
  if mkdir "$HB_LOCK" 2>/dev/null; then
    echo $$ > "$HB_LOCK/pid" 2>/dev/null || true
    HB_LOCK_DEPTH=1
    return 0
  fi
  # Held by another process — break it only if provably stale: holder dead, pid
  # never written (crashed between mkdir and echo), or age past any legal mutation
  # (worst real hold ≈60s: update-restart = kill 15s + launch 30s + tab reopen).
  local holder lts lnow age
  holder=$(cat "$HB_LOCK/pid" 2>/dev/null || echo "")
  lts=$(stat -f %m "$HB_LOCK" 2>/dev/null || echo 0); lnow=$(date +%s); age=$(( lnow - lts ))
  if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } \
     || { [ -z "$holder" ] && [ "$age" -gt 10 ]; } \
     || [ "$age" -gt 120 ]; then
    rm -rf "$HB_LOCK" 2>/dev/null || true
    if mkdir "$HB_LOCK" 2>/dev/null; then
      echo $$ > "$HB_LOCK/pid" 2>/dev/null || true
      HB_LOCK_DEPTH=1
      return 0
    fi
  fi
  return 1
}
hb_unlock() {
  [ "$HB_LOCK_DEPTH" -gt 0 ] || return 0
  HB_LOCK_DEPTH=$((HB_LOCK_DEPTH - 1))
  if [ "$HB_LOCK_DEPTH" -eq 0 ]; then rm -rf "$HB_LOCK" 2>/dev/null || true; fi
  return 0
}

# ── display sleep: paint needs compositing, compositing needs an awake display ──
# With the display asleep (esp. clamshell: lid closed, box kept awake by SSH/AC),
# WindowServer composites nothing, so Page.captureScreenshot hangs on EVERY tab and
# the wedge probe below false-positives — killing healthy GPU processes achieves
# nothing (seen live on the Air, 2026-07-11).
#
# DO NOT WAKE THE DISPLAY (tried in v0.8.4/5, measured, reverted): a user-activity
# declaration (caffeinate -u) does resume compositing in ~20ms, but macOS force-
# re-blanks a lid-closed display ~10s after ANY wake — held assertions and 5s
# re-declarations don't prevent it — and on that transition Chrome for Testing
# drops EVERY DevTools websocket (all sessions', not just ours; measured with lsof:
# even Chrome's own extension-page CDP clients disconnect). One wake = one delayed
# connection massacre. So when the display sleeps we skip the paint probe and
# proceed: DOM automation over a stable websocket works fine; screenshots need a
# display that never sleeps — attach a virtual one (BetterDisplay, DeskPad, or an
# HDMI dummy plug) for lid-closed visual work.

# display_asleep: 0 when the main display is asleep (no compositing possible).
display_asleep() {
  python3 - <<'PY' 2>/dev/null
import ctypes, sys
cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
sys.exit(0 if cg.CGDisplayIsAsleep(cg.CGMainDisplayID()) else 1)
PY
}

clamshell() {
  if ioreg -r -k AppleClamshellState -d 1 2>/dev/null \
       | grep -c '"AppleClamshellState" = Yes' >/dev/null
  then echo Yes; else echo No; fi
}

# gpu_healthy [timeout]: 0 = paints fine, 1 = wedged (screenshot hangs), 2 = can't
# tell. Probes with a 1x1 Page.captureScreenshot — it needs a composited frame, so
# it hangs exactly when the GPU is wedged — over a dependency-free stdlib websocket.
gpu_healthy() {
  python3 - "$PORT" "${1:-5}" <<'PY'
import sys, os, json, socket, base64, struct, urllib.request
port, timeout = sys.argv[1], float(sys.argv[2])
def http_json(p):
    return json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}{p}", timeout=4))
def ws_connect(path):
    s = socket.create_connection(("127.0.0.1", int(port)), timeout=5)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall((f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\n"
               "Upgrade: websocket\r\nConnection: Upgrade\r\n"
               f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        c = s.recv(1024)
        if not c: raise ConnectionError("handshake closed")
        buf += c
    if b" 101 " not in buf.split(b"\r\n", 1)[0]: raise ConnectionError("no upgrade")
    return s
def ws_send_text(s, payload):
    d = payload.encode(); n = len(d); m = os.urandom(4); h = bytearray([0x81])
    if n < 126: h.append(0x80 | n)
    elif n < 65536: h.append(0x80 | 126); h += struct.pack(">H", n)
    else: h.append(0x80 | 127); h += struct.pack(">Q", n)
    h += m; s.sendall(bytes(h) + bytes(b ^ m[i % 4] for i, b in enumerate(d)))
def ws_recv_frame(s):
    def rd(n):
        b = b""
        while len(b) < n:
            c = s.recv(n - len(b))
            if not c: raise ConnectionError("closed")
            b += c
        return b
    ln = rd(2)[1] & 0x7f
    if ln == 126: ln = struct.unpack(">H", rd(2))[0]
    elif ln == 127: ln = struct.unpack(">Q", rd(8))[0]
    return rd(ln)
try:
    pages = [t for t in http_json("/json/list")
             if t.get("type") == "page" and t.get("webSocketDebuggerUrl")]
    if not pages: sys.exit(2)
    s = ws_connect("/devtools/" + pages[0]["webSocketDebuggerUrl"].split("/devtools/", 1)[1])
except Exception:
    sys.exit(2)
req = json.dumps({"id": 1, "method": "Page.captureScreenshot",
                  "params": {"format": "png",
                             "clip": {"x": 0, "y": 0, "width": 1, "height": 1, "scale": 1}}})
try:
    ws_send_text(s, req); s.settimeout(timeout)
    while True:
        if json.loads(ws_recv_frame(s)).get("id") == 1: sys.exit(0)  # any reply = GPU alive
except (socket.timeout, TimeoutError):
    sys.exit(1)   # no frame within timeout = wedged
except Exception:
    sys.exit(2)
PY
}

# heal_gpu: restart ONLY this profile's wedged GPU process; Chrome respawns it.
heal_gpu() {
  local pids
  pids=$(ps -ww -o pid,command -ax | grep -- "--type=gpu-process" \
           | grep -F -- "--user-data-dir=$PROFILE" | grep -v grep | awk '{print $1}') || true
  if [ -z "$pids" ]; then
    echo "horse-browser: GPU wedged but no matching GPU process found — quit the browser and re-run." >&2
    return 1
  fi
  echo "horse-browser: GPU wedged after sleep — restarting GPU process ($pids); Chrome will respawn it." >&2
  heal_log wedge-healed "gpu_pid=${pids//$'\n'/,}" \
    "gpu_etime=$(ps -o etime= -p "${pids%%$'\n'*}" 2>/dev/null | xargs || true)"
  date +%s > "$HEAL_STAMP" 2>/dev/null || true   # backoff stamp: no second kill soon after

  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 15); do
    sleep 1
    cdp_up || continue
    if display_asleep; then
      # Display fell asleep mid-heal: recovery can't be verified by paint, and
      # waking would cause the CDP-connection drop described above. Assume the
      # respawned GPU process is fine and let the next awake probe re-check.
      echo "horse-browser: display slept during the heal — assuming recovery." >&2
      heal_log wedge-heal-unverified "clamshell=$(clamshell)"
      return 0
    fi
    if gpu_healthy 6; then echo "horse-browser: GPU recovered on :$PORT" >&2; return 0; fi
  done
  echo "horse-browser: GPU did not recover from the process kill — escalating to a full relaunch." >&2
  heal_log wedge-heal-failed "waited=15s"
  return 1
}

# recently_healed: a GPU-process kill happened within the backoff window (sets
# HEAL_AGO). A second kill that soon risks tripping Chrome's crash-count fallback
# (see gpu_fallback), so the caller escalates to relaunch_browser instead.
# Reads the pre-0.9.7 GLOBAL stamp as a floor, so an upgrade landing inside the backoff
# window still sees the kill that just happened. Never written and never removed: moving it
# would steal the backoff from a v0.9.6 launcher still running (or a rollback), and it stops
# mattering by itself once it ages past the window.
recently_healed() {
  local last now legacy
  last=$(cat "$HEAL_STAMP" 2>/dev/null || echo 0); now=$(date +%s)
  legacy=$(cat "$HEAL_STAMP_LEGACY" 2>/dev/null || echo 0)
  [ "$legacy" -gt "$last" ] 2>/dev/null && last="$legacy"
  HEAL_AGO=$(( now - last ))
  [ "$HEAL_AGO" -lt "${HORSE_BROWSER_HEAL_BACKOFF:-600}" ]
}

# gpu_fallback: 0 when this profile's GPU process runs in software-GL fallback (sets
# GPU_FALLBACK_INFO to its "pid command" line). gpu_healthy can't catch this state —
# software rendering paints fine — so it's probed separately on every invocation.
gpu_fallback() {
  GPU_FALLBACK_INFO=$(ps -ww -o pid=,command= -ax | grep -- "--type=gpu-process" \
    | grep -F -- "--user-data-dir=$PROFILE" | grep -v grep \
    | grep -E -- '--use-gl=disabled|--use-angle=swiftshader' | head -1) || true
  [ -n "$GPU_FALLBACK_INFO" ]
}

# relaunch_browser <reason> [k=v …]: full quit + relaunch, preserving tabs. The only
# recovery for the software-GL fallback (the crash-count state is in-memory), and the
# escalation when a GPU-process kill didn't stick. Tab URLs are saved first; any the
# browser's own session-restore doesn't bring back are reopened (deduped). A lock
# keeps concurrent invocations — the usual trigger is several sessions healing at
# once after wake — from relaunching over each other.
relaunch_browser() {
  local reason="${1:-relaunch}"; shift || true
  if ! hb_lock; then
    say "horse-browser: another invocation is already working on the browser — waiting…"
    for _ in $(seq 1 90); do [ -d "$HB_LOCK" ] || break; sleep 1; done
    cdp_up && return 0
    return 1
  fi

  say "horse-browser: relaunching the browser ($reason) — open tabs will be restored…"

  # 1. save real page URLs so nothing is lost across the quit
  # Keyed to the profile: concurrent relaunches (many sessions healing after a wake) would
  # otherwise overwrite each other's saved tab list and reopen the wrong browser's tabs.
  local saved="${PROFILE%/}.relaunch-tabs.json" tabs_n
  tabs_n=$(python3 - "$PORT" "$saved" 2>/dev/null <<'PY' || echo "?"
import json, sys, urllib.request
port, out = sys.argv[1], sys.argv[2]
try:
    tabs = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/list", timeout=4))
    urls = [t["url"] for t in tabs if t.get("type") == "page"
            and t.get("url", "").startswith(("http://", "https://", "file://"))]
except Exception:
    urls = []
json.dump(urls, open(out, "w"))
print(len(urls))
PY
)
  heal_log "$reason" "tabs_saved=$tabs_n" "$@"

  # 2. quit THIS profile's browser (graceful, then force) and wait for it to exit
  local bpids gone p
  bpids=$(ps -ww -o pid,command -ax | grep -F -- "--user-data-dir=$PROFILE" \
            | grep -v -- "--type=" | grep -v grep | awk '{print $1}') || true
  if [ -n "$bpids" ]; then
    # shellcheck disable=SC2086
    kill $bpids 2>/dev/null || true
    gone=
    for _ in $(seq 1 30); do
      gone=1
      for p in $bpids; do kill -0 "$p" 2>/dev/null && { gone=; break; }; done
      [ -n "$gone" ] && break
      sleep 0.5
    done
    # shellcheck disable=SC2086
    [ -z "$gone" ] && { kill -9 $bpids 2>/dev/null || true; sleep 1; }
  fi

  # 3. fresh launch (ensure_browser takes its launch path now that the browser is
  #    gone; its hb_lock is re-entrant, so our hold carries through)
  if ! ensure_browser; then
    heal_log relaunch-failed "reason=$reason"
    hb_unlock
    return 1
  fi
  rm -f "$HEAL_STAMP" 2>/dev/null || true   # fresh browser: crash count is 0, kills are safe again

  # 4. reopen whatever the browser's own session-restore didn't bring back
  sleep 3   # let session-restore land first, so the dedupe below sees its tabs
  local n
  n=$(python3 - "$PORT" "$saved" 2>/dev/null <<'PY' || echo 0
import json, sys, urllib.parse, urllib.request
port, path = sys.argv[1], sys.argv[2]
try: saved = json.load(open(path))
except Exception: saved = []
try:
    cur = {t.get("url") for t in json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/list", timeout=4))}
except Exception:
    cur = set()
n = 0
for u in dict.fromkeys(saved):                    # keep order, drop duplicates
    if u in cur: continue
    try:                                          # /json/new takes the raw URL as its query
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/json/new?{urllib.parse.quote(u, safe='')}", method="PUT")
        urllib.request.urlopen(req, timeout=5); n += 1
    except Exception: pass
print(n)
PY
)
  say "horse-browser: relaunched — $n tab(s) reopened beyond session-restore."
  hb_unlock
  return 0
}

# reap_orphan_daemons: stop per-session browser-harness daemons (BU_NAME hb-*, or the
# legacy cc-*) whose anchoring agent session has exited. Conservative by design: it only
# touches daemons whose env carries BOTH a BU_NAME WE named (in driver mode below) and a
# BH_ANCHOR_PID, and only when that anchor PID is gone — so it never reaps the shared
# "default" daemon, an explicit BU_NAME lane, or any live session. A browser-harness with
# the self-reap patch already cleans up its own daemons; this covers a stock one, which
# otherwise leaks one daemon per ended session. HORSE_BROWSER_REAP_DRYRUN=1 logs only.
reap_orphan_daemons() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - <<'PY' || true
import os, sys, signal, subprocess
def main():
    dry = bool(os.environ.get("HORSE_BROWSER_REAP_DRYRUN"))
    def envof(pid):
        try:
            out = subprocess.run(["ps", "eww", "-o", "command=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=3).stdout
        except Exception:
            return {}
        e = {}
        for tok in out.split():
            if "=" in tok:
                k, v = tok.split("=", 1)
                if k.isupper():
                    e[k] = v
        return e
    def alive(pid):
        try:
            os.kill(int(pid), 0); return True
        except Exception:
            return False
    try:
        pids = subprocess.run(["pgrep", "-f", "(browser|horse)_harness.daemon"],
                              capture_output=True, text=True, timeout=3).stdout.split()
    except Exception:
        return
    for pid in pids:
        e = envof(pid)
        if not e.get("BU_NAME", "").startswith(("hb-", "cc-")):  # only daemons we named
            continue
        anchor = e.get("BH_ANCHOR_PID")
        if not anchor or alive(anchor):                  # unverifiable or session live -> keep
            continue
        if not dry:
            try: os.kill(int(pid), signal.SIGTERM)
            except Exception: continue
        # log on stderr so it's visible but never pollutes a driver script's stdout
        print(f"horse-browser: {'would reap' if dry else 'reaped'} orphan daemon "
              f"pid={pid} {e['BU_NAME']} (anchor {anchor} gone)", file=sys.stderr, flush=True)
try: main()
except Exception: pass
PY
}

# reap_orphan_tabs: close tabs left behind by ENDED agent sessions — the pile of stray
# about:blank (from a tab-less session's homing) and abandoned work tabs (from a killed
# process) that otherwise accumulate forever. A session's tabs live in a group the extension
# titles by codename; a session is LIVE if it has a daemon whose anchor process is alive (or
# a daemon with no anchor — unverifiable, kept conservatively, exactly like reap_orphan_daemons).
# The launcher gathers the live session ids and hands them to the extension, which closes tabs
# in every group that isn't a live session's. Hard safety: never acts on an empty live set.
# HORSE_BROWSER_NO_TAB_REAP=1 disables it. DRYRUN via HORSE_BROWSER_REAP_DRYRUN.
reap_orphan_tabs() {
  [ -n "${HORSE_BROWSER_NO_TAB_REAP:-}" ] && return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$PORT" "$ROOT/tools" <<'PY' || true
import sys, os, json, subprocess
port, tools = sys.argv[1], sys.argv[2]
dry = bool(os.environ.get("HORSE_BROWSER_REAP_DRYRUN"))

def alive(pid):
    try: os.kill(int(pid), 0); return True
    except Exception: return False

# Live agent sessions = HORSE_SESSION of every daemon whose anchor is alive, or whose anchor
# is absent (can't disprove — keep). Mirrors reap_orphan_daemons' conservatism.
def live_sessions():
    out = set()
    try:
        pids = subprocess.run(["pgrep", "-f", "(browser|horse)_harness.daemon"],
                              capture_output=True, text=True, timeout=3).stdout.split()
    except Exception:
        return out
    for pid in pids:
        try:
            env = subprocess.run(["ps", "eww", "-o", "command=", "-p", pid],
                                 capture_output=True, text=True, timeout=3).stdout
        except Exception:
            continue
        e = {}
        for tok in env.split():
            if "=" in tok:
                k, v = tok.split("=", 1)
                if k.isupper(): e[k] = v
        s = e.get("HORSE_SESSION")
        if not s:
            continue
        anchor = e.get("BH_ANCHOR_PID")
        if anchor and not alive(anchor):
            continue                        # session's process is gone -> not live
        out.add(s)
    return out

live = live_sessions()
if not live:                                # safety: never reap when we can see no live session
    sys.exit(0)

sys.path.insert(0, tools)                   # sw_eval: our one channel into a live browser
try:
    from sw_eval import evaluate
except Exception:
    sys.exit(0)

expr = "self.reapDeadTabs(%s)" % json.dumps(sorted(live))
if dry:
    # count-only: title the dead groups without removing
    expr = ("(async()=>{const live=new Set(%s.map(s=>codename(s).title));"
            "const tabs=await chrome.tabs.query({});const gs=await chrome.tabGroups.query({});"
            "const byid=new Map(gs.map(g=>[g.id,g.title]));"
            "return JSON.stringify({closed:tabs.filter(t=>t.groupId>=0&&!live.has(byid.get(t.groupId))).length});})()"
            % json.dumps(sorted(live)))
val = evaluate(port, expr)
try: closed = json.loads(val).get("closed", 0) if isinstance(val, str) else (val or {}).get("closed", 0)
except Exception: closed = 0
if closed:
    print("horse-browser: %s %d orphan tab(s) from ended sessions"
          % ("would reap" if dry else "reaped", closed), file=sys.stderr, flush=True)
PY
}

# seed_instance_env: tell THIS browser's extension which debug port it lives on.
# Many horse-browsers run at once (one per agent), each on its own port + profile, and an
# extension can't read argv — so the in-browser Monitor, which is a second CDP client and
# therefore needs a port, has no way to find its own browser. We write it into the profile's
# chrome.storage.local (per-profile ⇒ per-instance) at every launch, which is exactly when
# the port can change. Best-effort: the Monitor verifies the port before trusting it and
# falls back to a self-identifying probe, so a missed seed degrades, it doesn't break.
seed_instance_env() {
  local wait="${1:-0}"                      # seconds to wait for the (MV3, sleepy) service worker
  [ -n "$EXT" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  [ -n "$ROOT" ] && [ -f "$ROOT/tools/sw_eval.py" ] || return 0
  python3 "$ROOT/tools/sw_eval.py" "$PORT" \
    "(async()=>{await chrome.storage.local.set({hbCdpPort:$PORT});return 1})()" "$wait" >/dev/null 2>&1 || true
}

# reap_stale_runtime: GC the per-session runtime files (pid/sock/lock/port) left by daemons that
# died UNCLEANLY (SIGKILL, crash, a chaos test, a killed parent). A clean shutdown unlinks its own
# PID, but an unclean death leaves the set — and session names are UNIQUE (hb-<hash>, hb-<pid>-lane,
# test names), so lifecycle's same-name cleanup never fires and they pile up forever (observed 53
# stale sets over 4 days). Only removes a set whose .pid process is PROVABLY DEAD; a live daemon's
# files (kill -0 succeeds — including a recycled PID, kept conservatively) are never touched. Bare
# "bu.*" files (BH_RUNTIME_DIR-isolated daemons that own their whole dir) don't match "bu-*".
reap_stale_runtime() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - <<'PY' || true
import os, sys, glob, time
dry = bool(os.environ.get("HORSE_BROWSER_REAP_DRYRUN"))
rt = os.environ.get("BH_RUNTIME_DIR")
rt = os.path.expanduser(rt) if rt else os.path.expanduser("~/.config/browser-harness/runtime")
def alive(pid):
    try: os.kill(int(pid), 0); return True
    except Exception: return False
def rm(f):
    if os.path.exists(f) and not dry:
        try: os.unlink(f)
        except OSError: pass
sets = 0; have_pid = set()
# 1) a bu-*.pid whose process is dead -> drop the whole set
for pidf in glob.glob(os.path.join(rt, "bu-*.pid")):
    stem = pidf[:-4]; have_pid.add(stem)
    try: pid = open(pidf).read().strip()
    except Exception: continue
    if not pid or alive(pid): continue
    for ext in (".pid", ".sock", ".lock", ".port"): rm(stem + ext)
    sets += 1
# 2) an orphan sock/lock/port with no .pid sibling, older than the reap interval (never mid-spawn)
cutoff = time.time() - 300
for f in glob.glob(os.path.join(rt, "bu-*")):
    if f.endswith(".pid") or f.rsplit(".", 1)[0] in have_pid: continue
    try:
        if os.path.getmtime(f) < cutoff: rm(f)
    except OSError: pass
if sets:
    print("horse-browser: %s %d stale daemon runtime set(s)" % ("would reap" if dry else "reaped", sets),
          file=sys.stderr, flush=True)
PY
}

# maybe_reap: run reap_orphan_daemons at most once per interval (cheap stamp-file throttle),
# so it costs nothing on the hot path. HORSE_BROWSER_NO_REAP=1 disables it entirely.
# The stamp is per-profile: two instances share nothing here, so a sibling's sweep can't
# make THIS browser skip its own tab reap (and port re-seed) for the rest of the interval.
maybe_reap() {
  [ -n "${HORSE_BROWSER_NO_REAP:-}" ] && return 0
  local stamp="${HORSE_BROWSER_REAP_STAMP:-${PROFILE%/}.last-reap}"
  local interval="${HORSE_BROWSER_REAP_INTERVAL:-600}" now last
  now=$(date +%s); last=$(cat "$stamp" 2>/dev/null || echo 0)
  [ $(( now - last )) -lt "$interval" ] && return 0
  mkdir -p "$(dirname "$stamp")" 2>/dev/null || true
  echo "$now" > "$stamp" 2>/dev/null || true
  reap_orphan_daemons
  reap_orphan_tabs
  reap_stale_runtime
  seed_instance_env   # re-assert the port for a browser that was already up (e.g. across an upgrade)
}

# recycle_daemons: after a browser (re)launch, every harness daemon pinned to our
# CDP endpoint still holds a websocket into the DEAD browser — browser-harness
# caches the connection for the daemon's whole life and only self-heals when that
# session's NEXT call notices and respawns the daemon, i.e. one failed call per
# session per bounce. Recycling here makes every session's next call land on a
# fresh daemon. Match is exact on BU_CDP_URL in the daemon's env — never touches
# daemons driving other endpoints (cloud, other browsers).
recycle_daemons() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$PORT" <<'PY' || true
import os, signal, subprocess, sys
want = f"BU_CDP_URL=http://127.0.0.1:{sys.argv[1]}"
try:
    pids = subprocess.run(["pgrep", "-f", "(browser|horse)_harness.daemon"],
                          capture_output=True, text=True, timeout=3).stdout.split()
except Exception:
    pids = []
n = 0
for pid in pids:
    try:
        env = subprocess.run(["ps", "eww", "-o", "command=", "-p", pid],
                             capture_output=True, text=True, timeout=3).stdout.split()
    except Exception:
        continue
    if want not in env:
        continue
    try:
        os.kill(int(pid), signal.SIGTERM); n += 1
    except Exception:
        pass
if n:
    print(f"horse-browser: recycled {n} harness daemon(s) onto the fresh browser",
          file=sys.stderr, flush=True)
PY
}

# ── status / update ──────────────────────────────────────────────────────────
_chrome_ver() { echo "${1:-}" | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1; }

hb_status() {
  local ver running
  ver="$(git -C "$ROOT" describe --tags 2>/dev/null || true)"
  # No git checkout (e.g. an `npm i -g` install)? Fall back to package.json's version.
  if [ -z "$ver" ]; then
    ver="$(python3 - "$ROOT" <<'PY' 2>/dev/null || true
import json, os, sys
try: print("v" + json.load(open(os.path.join(sys.argv[1], "package.json")))["version"])
except Exception: pass
PY
)"
  fi
  ver="${ver:-?}"
  # `|| true` is load-bearing: with the browser DOWN, curl fails, pipefail hands that status to
  # the assignment, and set -e kills the command before it prints anything — `status` went
  # silent and `update` stopped applying, in exactly the situation you run them for.
  running="$(curl -s "http://127.0.0.1:$PORT/json/version" 2>/dev/null \
             | grep -oE '"Browser": *"[^"]*"' | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1 || true)"
  echo "horse-browser $ver"
  printf '  %-18s %s\n' "chrome (pinned)"  "$(_chrome_ver "$BIN")"
  if cdp_up; then printf '  %-18s %s  (live on :%s)\n' "chrome (running)" "${running:-?}" "$PORT"
  else            printf '  %-18s %s\n'               "chrome (running)" "down"; fi
  if [ -x "$HARNESS_PY" ]; then
    printf '  %-18s %s\n' "horse-harness" "vendored ($HARNESS_DIR/horse_harness, venv ready)"
  else
    printf '  %-18s %s\n' "horse-harness" "venv not built (runs on first driver call, or: horse-browser harness-setup)"
  fi
  printf '  %-18s %s\n' "profile"  "$PROFILE"
  printf '  %-18s %s\n' "config"   "$CONFIG"
}

# sync_realness_version <full-version>: keep the realness mask's sec-ch-ua request header
# (extension/rules.json) in lockstep with the browser's major version. A UA-vs-sec-ch-ua
# major-version mismatch is a bot tell — Cloudflare Turnstile flags it — and it silently
# drifts whenever Chrome for Testing self-updates past the version the header was written for.
# (realchrome.js derives the JS half from the live UA itself; only the static header needs this.)
# Writes only when the major actually differs, so a matching launch is a no-op.
sync_realness_version() {
  local ver="$1"; [ -n "$ver" ] && [ -n "$EXT" ] && [ -f "$EXT/rules.json" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$EXT/rules.json" "$ver" <<'PY' || true
import json, re, sys
p, major = sys.argv[1], sys.argv[2].split(".")[0]
try: data = json.load(open(p))
except Exception: sys.exit(0)
changed = False
for rule in data if isinstance(data, list) else []:
    for h in (rule.get("action") or {}).get("requestHeaders") or []:
        if h.get("header") == "sec-ch-ua" and h.get("operation") == "set" and isinstance(h.get("value"), str):
            nv = re.sub(r'("Chromium";v=")\d+(")', r'\g<1>%s\g<2>' % major, h["value"])
            nv = re.sub(r'("Google Chrome";v=")\d+(")', r'\g<1>%s\g<2>' % major, nv)
            if nv != h["value"]:
                h["value"] = nv; changed = True
if changed:
    json.dump(data, open(p, "w"), indent=2)
    open(p, "a").write("\n")
    print(f"horse-browser: synced sec-ch-ua realness header → Chrome {major}", file=sys.stderr)
PY
}

# sync_manifest_version: keep the extension manifest's "version" equal to the package
# version. They ship together in the npm package, so package.json is the source of truth;
# the manifest is metadata Chrome reads and that a release bump can silently leave behind.
# Self-heals at launch (write-only-if-changed) so a forgotten manual bump can't drift it —
# same pattern as sync_realness_version. Strips any prerelease/build suffix, since an
# extension version must be 1-4 dot-separated integers.
sync_manifest_version() {
  [ -n "$EXT" ] && [ -f "$EXT/manifest.json" ] && [ -n "$ROOT" ] && [ -f "$ROOT/package.json" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$ROOT/package.json" "$EXT/manifest.json" <<'PY' || true
import json, sys
pkg, man = sys.argv[1], sys.argv[2]
try:
    ver = str(json.load(open(pkg))["version"]).split("-")[0].split("+")[0]
    data = json.load(open(man))
except Exception: sys.exit(0)
if data.get("version") != ver:
    data["version"] = ver
    json.dump(data, open(man, "w"), indent=2)
    open(man, "a").write("\n")
    print(f"horse-browser: synced extension manifest version → {ver}", file=sys.stderr)
PY
}

hb_update() {
  require_macos || return 1
  command -v npx >/dev/null 2>&1 || { echo "horse-browser: npx (Node) not found — needed to fetch Chrome." >&2; return 1; }
  local oldver out newbin newver
  oldver="$(_chrome_ver "$BIN")"
  echo "horse-browser: resolving the latest Chrome for Testing (chrome@stable)…"
  out="$(npx -y @puppeteer/browsers install chrome@stable --path "$CACHE")" \
    || { echo "horse-browser: fetch failed." >&2; return 1; }
  newbin="$(printf '%s\n' "$out" | grep '^chrome@' | tail -1 | sed 's/^[^ ]* //')"
  [ -n "$newbin" ] && [ -x "$newbin" ] || { echo "horse-browser: couldn't resolve the new binary." >&2; return 1; }
  newver="$(_chrome_ver "$newbin")"
  sync_realness_version "$newver"   # keep the sec-ch-ua realness header matched to the new browser
  if [ "$newbin" != "$BIN" ]; then
    python3 - "$CONFIG" "$newbin" <<'PY'
import os, sys
cfg, newbin = sys.argv[1], sys.argv[2]
lines = open(cfg).read().splitlines() if os.path.exists(cfg) else []
out, seen = [], False
for l in lines:
    if l.startswith("BROWSER_BIN="): out.append(f'BROWSER_BIN="{newbin}"'); seen = True
    else: out.append(l)
if not seen: out.append(f'BROWSER_BIN="{newbin}"')
open(cfg, "w").write("\n".join(out) + "\n")
PY
    echo "horse-browser: Chrome ${oldver:-?} → $newver  (updated $CONFIG)"
  else
    echo "horse-browser: latest stable is $newver."
  fi
  # Apply it: restart onto the latest, unless the browser is already running that version.
  local running
  # `|| true` is load-bearing: with the browser DOWN, curl fails, pipefail hands that status to
  # the assignment, and set -e kills the command before it prints anything — `status` went
  # silent and `update` stopped applying, in exactly the situation you run them for.
  running="$(curl -s "http://127.0.0.1:$PORT/json/version" 2>/dev/null \
             | grep -oE '"Browser": *"[^"]*"' | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1 || true)"
  if [ "$running" = "$newver" ]; then echo "horse-browser: already running $newver — nothing to apply."; return 0; fi
  echo "horse-browser: restarting onto ${newver}…"
  # Profile-scoped restart via the relaunch machinery (tabs preserved, single-flight
  # locked). NOT osascript 'quit app …': an app-name quit goes to whichever instance
  # of the bundle registered with LaunchServices first — with other tools running
  # the same cached bundle on their own profiles, that quits an innocent browser
  # and leaves ours on the old version. BIN is updated in-process so the relaunch
  # spawns the new binary directly.
  BIN="$newbin"
  relaunch_browser update-restart "to=$newver"
}

# ensure_browser: bring the browser up (launching if needed) and self-heal a GPU
# wedge. Returns 0 when CDP is live and painting; non-zero if it can't recover.
ensure_browser() {
  require_macos || return 1
  if cdp_up; then
    say "horse-browser: already up on :$PORT"
    if gpu_fallback; then
      local fb_pid fb_flag
      fb_pid=$(awk '{print $1}' <<<"$GPU_FALLBACK_INFO")
      fb_flag=$(grep -oE -- '--use-gl=disabled|--use-angle=swiftshader' <<<"$GPU_FALLBACK_INFO" | head -1)
      say "horse-browser: GPU stuck in software rendering ($fb_flag) — relaunching to restore hardware GL."
      relaunch_browser fallback-relaunch "flag=$fb_flag" "gpu_pid=$fb_pid" \
        "gpu_etime=$(ps -o etime= -p "$fb_pid" 2>/dev/null | xargs || true)" || return 1
      return 0
    fi
    if display_asleep; then
      # No compositing, so the paint probe would hang — and it is NOT a GPU wedge.
      # Never wake the display for it (see the display-sleep block above: any wake
      # triggers a delayed re-blank that kills every CDP websocket browser-wide).
      say "horse-browser: display asleep — skipping paint check (DOM automation works; screenshots need a virtual display)."
      local dstamp="$HOME/.config/horse-browser/.last-display-asleep-log" dnow dlast
      dnow=$(date +%s); dlast=$(cat "$dstamp" 2>/dev/null || echo 0)
      if [ $(( dnow - dlast )) -gt 1800 ]; then      # log the episode, not every call
        echo "$dnow" > "$dstamp" 2>/dev/null || true
        heal_log display-asleep "clamshell=$(clamshell)"
      fi
      return 0
    fi
    local rc=0
    gpu_healthy 6 || rc=$?
    if [ "$rc" = 1 ]; then                            # wedged (display awake, still no paint)
      if ! hb_lock; then
        say "horse-browser: GPU wedged — another invocation is already on it; waiting…"
        for _ in $(seq 1 60); do [ -d "$HB_LOCK" ] || break; sleep 1; done
        cdp_up && return 0
        return 1
      fi
      # Re-probe under the lock: our probe may predate a heal another session just
      # finished — acting on the stale result would stack a second GPU kill, or
      # escalate to a needless full relaunch via the recently_healed check.
      local rc2=0
      gpu_healthy 6 || rc2=$?
      if [ "$rc2" != 1 ]; then hb_unlock; return 0; fi
      local _hrc=0
      if recently_healed; then                        # a kill just happened — don't stack kills
        say "horse-browser: GPU wedged again ${HEAL_AGO}s after a kill — escalating to a full relaunch."
        relaunch_browser wedge-relaunch "last_kill=${HEAL_AGO}s" || _hrc=1
      else
        heal_gpu || relaunch_browser wedge-relaunch "after=failed-heal" || _hrc=1
      fi
      hb_unlock
      [ "$_hrc" = 0 ] || return 1
    fi
    return 0                                          # 0 = paints fine, 2 = no page to probe
  fi

  if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
    echo "horse-browser: no browser configured (BROWSER_BIN missing or not executable)." >&2
    echo "  Fetch Chrome for Testing with 'horse-browser update', run the repo's ./install.sh," >&2
    echo "  or point HORSE_BROWSER_BIN at your own Chromium." >&2
    return 1
  fi

  # ── single-flight: exactly one invocation launches; the rest wait on CDP ──
  if ! hb_lock; then
    say "horse-browser: another invocation is launching the browser — waiting…"
    for _ in $(seq 1 45); do
      sleep 1
      cdp_up && { say "horse-browser: ready on :$PORT (launched by another invocation)"; return 0; }
      [ -d "$HB_LOCK" ] || break
    done
    # Lock released but CDP still down → the winner failed; one hand-off retry.
    if ! hb_lock; then
      echo "horse-browser: browser is down and another invocation holds the lock — giving up." >&2
      return 1
    fi
  fi
  if cdp_up; then   # raced: it came up between our first check and taking the lock
    hb_unlock
    say "horse-browser: ready on :$PORT (launched by another invocation)"
    return 0
  fi
  local _lrc=0
  launch_browser || _lrc=$?
  hb_unlock
  return $_lrc
}

# launch_browser: the actual cold launch — pre-launch gate, profile seeding, spawn,
# CDP wait. Only ever called with the single-flight lock held (see ensure_browser).
launch_browser() {
  # ── pre-launch gate: the profile must be truly free before we seed + launch ──
  # Two proven failure modes when a previous browser process still holds the
  # profile (a slow shutdown after `hb_update`'s quit, a crashed launch, an
  # external quit): (1) Chrome writes Preferences back FROM MEMORY on exit, so a
  # seed written in that window is silently clobbered — measured: a key written
  # while Chrome runs is gone after quit; (2) even with `open -n` (below), Chrome's
  # ProcessSingleton makes a new process defer to the one still holding the profile
  # and exit. So: wait for lingering processes (they may be mid-shutdown), then
  # hard-kill what remains.
  local _lpids _p _gone
  _lpids=$(ps -ww -o pid= -o command= -ax | grep -F -- "--user-data-dir=$PROFILE" \
             | grep -v -- "--type=" | grep -v grep | awk '{print $1}') || true
  if [ -n "$_lpids" ]; then
    say "horse-browser: previous browser process still exiting — waiting…"
    for _ in $(seq 1 30); do
      _gone=1
      for _p in $_lpids; do kill -0 "$_p" 2>/dev/null && { _gone=; break; }; done
      [ -n "$_gone" ] && break
      sleep 0.5
    done
    if [ -z "$_gone" ]; then
      # shellcheck disable=SC2086
      kill -9 $_lpids 2>/dev/null || true
      sleep 1
      say "horse-browser: force-killed a stuck browser process holding the profile."
    fi
  fi

  # Seed profile defaults that make this feel like a dedicated agent browser: pin the
  # extension's toolbar button (extensions.pinned_extensions), switch on the vertical
  # (left) tab strip (vertical_tabs), turn off "save password?" popups (they steal focus
  # and aren't gated by focus emulation), and skip the confirm dialog when closing/
  # removing/deleting a tab group (it would block an agent mid-cleanup). All live in each
  # profile's Preferences, which Chrome owns — so we only touch them here, behind the
  # gate above, while the browser is provably stopped.
  #
  # EVERY profile is seeded (Default + "Profile N"): a profile the user creates in the
  # browser gets the look & feel on the next launch (Preferences can't be safely edited
  # while Chrome runs). The extension itself needs no per-profile work: --load-extension
  # loads into every profile of the session, secondary ones included (verified).
  # Keys are per-key set-if-absent — Chrome sometimes writes PARTIAL blocks (a new
  # profile gets vertical_tabs{collapsed_state,width} with no "enabled"), so block-level
  # "set if key missing" would skip them forever. A user's explicit choice (enabled:
  # false) is present, so setdefault keeps it. The pin is re-asserted each launch.
  # Writes are atomic (tmp + rename): a crash mid-write can't corrupt Preferences and
  # make Chrome reset the profile.
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$PROFILE" "$EXT" <<'PY' || echo "horse-browser: profile seeding failed (non-fatal) — settings may not apply this launch." >&2
import hashlib, json, os, sys
root, ext = sys.argv[1], sys.argv[2]

def seed(pref):
    d = {}
    if os.path.exists(pref):
        try: d = json.load(open(pref))
        except Exception: d = {}          # corrupt file: reseed fresh (Chrome would reset it anyway)
    if ext:                               # unpacked extension id = hash of its absolute path
        eid = "".join(chr(ord("a") + int(c, 16)) for c in hashlib.sha256(ext.encode()).hexdigest()[:32])
        tb = d.setdefault("extensions", {}).get("pinned_extensions")
        if not isinstance(tb, list): tb = []
        if eid not in tb: tb.append(eid)
        d["extensions"]["pinned_extensions"] = tb
    vt = d.setdefault("vertical_tabs", {})
    vt.setdefault("enabled", True)
    vt.setdefault("collapsed_state", False)
    vt.setdefault("uncollapsed_width", 240)
    vt.setdefault("enabled_first_time", True)
    d.setdefault("credentials_enable_service", False)   # no "save password?" popups
    tg = d.setdefault("tab_groups", {}).setdefault("deletion", {})
    for k in ("skip_dialog_on_close_tab", "skip_dialog_on_delete", "skip_dialog_on_remove_tab"):
        tg.setdefault(k, True)                           # no confirm dialog closing a tab group
    tmp = pref + ".horse-tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
        f.flush(); os.fsync(f.fileno())
    os.replace(tmp, pref)

profiles = [os.path.join(root, "Default")]
try:
    profiles += [os.path.join(root, n) for n in sorted(os.listdir(root))
                 if n.startswith("Profile ") and os.path.isdir(os.path.join(root, n))]
except FileNotFoundError:
    pass
for p in profiles:
    os.makedirs(p, exist_ok=True)
    seed(os.path.join(p, "Preferences"))
PY
  fi

  # The post-sleep freeze is the GPU-process wedge healed above, NOT occlusion throttling —
  # these flags don't fix that. But they ARE load-bearing for screenshots: without them
  # Chrome throttles/deprioritises BACKGROUND-tab renderers, and under multi-agent load a
  # backgrounded tab's renderer is starved so hard it never paints, so Page.captureScreenshot
  # (and even a screencast) return a degenerate 2x2. Disabling renderer backgrounding, the
  # background-timer throttle, and occluded-window backgrounding keeps every tab's renderer
  # live, so agents screenshot backgrounded tabs reliably without raising them window-visible.
  args=( --remote-debugging-port="$PORT" --user-data-dir="$PROFILE"
         --test-type             # suppresses the "unsupported command-line flag" infobar
         --disable-infobars      # hides the Chrome-for-Testing infobar (per Playwright's chromiumSwitches)
         --remote-allow-origins=* # lets the in-browser Monitor page open this browser's CDP socket
         --disable-renderer-backgrounding
         --disable-background-timer-throttling
         --disable-backgrounding-occluded-windows
         --no-first-run --no-default-browser-check )
  sync_manifest_version   # keep the extension's manifest version matched to the package before load
  [ -n "$EXT" ] && args+=( --load-extension="$EXT" )

  # Launch WITHOUT stealing focus. `open -g` starts the app in the background, so
  # the window appears but your current app keeps keyboard focus. `-n` forces a NEW
  # process: without it, LaunchServices routes the open to ANY running instance of
  # this bundle — e.g. another tool driving the same cached browser on its own
  # profile — and silently drops our --args (port, profile, extension), so nothing
  # ever appears on :$PORT. Safe: we only get here when :$PORT is down and the gate
  # above cleared our profile's holders. Falls back to a direct exec if the binary
  # isn't inside a .app bundle.
  APP="${BIN%/Contents/MacOS/*}"
  focus_breadcrumb "browser launch (open -g -n) — should NOT take focus; if a steal is logged near here, the launch or its welcome/restore is the cause"
  if [ "$APP" != "$BIN" ] && [ -d "$APP" ]; then
    open -g -n -a "$APP" --args "${args[@]}"
  else
    "$BIN" "${args[@]}" >/dev/null 2>&1 &
  fi

  say "horse-browser: launching… (waiting for CDP :$PORT)"
  for _ in $(seq 1 30); do
    cdp_up && { say "horse-browser: ready on :$PORT"; seed_instance_env 10; recycle_daemons; return 0; }
    sleep 1
  done
  # Log the incident with the one number that diagnoses the known cause: how many
  # OTHER instances of our binary were running (same-bundle collision, stray forks).
  local _others
  _others=$(ps -ww -axo command= | grep -F -- "$BIN" | grep -v grep \
              | grep -cv -- "--user-data-dir=$PROFILE") || true
  heal_log launch-timeout "port=$PORT" "other_instances=${_others:-0}"
  echo "horse-browser: timed out waiting for CDP :$PORT — check the browser window." >&2
  return 1
}

# horse-browser's own subcommands — handled here, never forwarded to browser-harness.
case "${1:-}" in
  status) hb_status; exit 0 ;;
  update) hb_update && exit 0 || exit 1 ;;
  relaunch)
    # Apply an upgraded horse-browser package (new launch flags + extension code) without a
    # Chrome version change: new launch args only bind to a fresh process, and the extension
    # is re-read from disk on relaunch. A single deliberate relaunch loads the new SW code
    # cleanly (the stale-SW-bytecode gotcha is specific to RAPID reload cycles, not this).
    # Do NOT wipe the Service Worker cache here — the browser rewrites it on exit, and wiping
    # mid-relaunch leaves the SW dead. (The focus-safe helpers load per-call, no relaunch.)
    relaunch_browser "apply-package-update" && exit 0 || exit 1
    ;;
  harness-setup)
    # install.sh / postinstall call this to build the harness venv up front.
    ensure_harness && exit 0 || exit 1
    ;;
  skill)
    # Print the on-demand manual (the always-on rule points agents here for depth).
    if [ -n "$ROOT" ] && [ -f "$ROOT/MANUAL.md" ]; then cat "$ROOT/MANUAL.md"; exit 0
    else echo "horse-browser: MANUAL.md not found under $ROOT — reinstall the package" >&2; exit 1; fi
    ;;
  rule)
    # First-class front for claude-md.sh (apply/print/check) — so setup docs can say
    # `horse-browser rule apply` instead of locating the package via `npm root -g`.
    shift
    if [ -n "$ROOT" ] && [ -f "$ROOT/claude-md.sh" ]; then exec bash "$ROOT/claude-md.sh" "$@"
    else echo "horse-browser: claude-md.sh not found under $ROOT — reinstall the package" >&2; exit 1; fi
    ;;
  verbs)
    # Introspect every loaded verb (core / plugins / local) with docstrings — powers the dashboard.
    # No browser needed: the harness prints and exits before touching the daemon.
    shift
    ensure_harness || exit 1
    exec "$HARNESS_PY" -m horse_harness.run verbs "$@"
    ;;
  focus-watch)
    # Log every macOS focus steal by the agent browser, to the millisecond. Run this, then
    # run whatever you suspect; grep the log for FOCUS-STOLEN. Ctrl-C to stop.
    _fw="$ROOT/tools/focus-watch.swift"
    [ -f "$_fw" ] || { echo "focus-watch: $_fw not found" >&2; exit 1; }
    command -v swift >/dev/null 2>&1 || { echo "focus-watch: needs swift (Xcode CLT)" >&2; exit 1; }
    echo "focus-watch: watching for Chrome-for-Testing focus steals — log: ~/.config/horse-browser/focus.log" >&2
    exec swift "$_fw"
    ;;
esac

ensure_browser || exit 1
maybe_reap   # opportunistically clean up daemons from ended sessions (throttled)

# Driver mode: run the captured script (and/or forwarded args) through the vendored
# horse-harness against our browser. exec replaces this process, so the harness
# inherits the here-string as its stdin exactly as if it had been called directly.
if [ -n "$PASSTHROUGH" ]; then
  ensure_harness || exit 1
  export BU_CDP_URL="http://127.0.0.1:$PORT"

  # ── identity: a generic contract, filled in by integrations ─────────────────
  # Core knows three things: HORSE_SESSION (who this agent session is — tab group +
  # daemon derive from it), HORSE_LANE (optional sub-identity within a session, set
  # via --lane above), and BH_ANCHOR_PID/BH_ANCHOR_START (the process this session's
  # daemon should die with). Explicit env always wins; otherwise each agent system's
  # integrations/<system>/detect.sh gets a chance to derive them from its own
  # environment (claude-code today; codex etc. are one detect.sh away). No identity
  # at all is fine too — grouping is skipped and browser-harness runs stock.
  if [ -z "${HORSE_SESSION:-}" ] && [ -n "$ROOT" ]; then
    for _detect in "$ROOT"/integrations/*/detect.sh; do
      [ -f "$_detect" ] || continue
      # shellcheck disable=SC1090
      . "$_detect"
      [ -n "${HORSE_SESSION:-}" ] && break
    done
  fi
  if [ -n "${HORSE_SESSION:-}" ]; then
    export HORSE_SESSION
    [ -n "$LANE" ] && export HORSE_LANE="$LANE"
    # Per-identity daemon, so concurrent agents never share one daemon and clobber
    # each other's current tab. browser-harness keys the daemon off BU_NAME; a lane
    # gets its own. An explicit BU_NAME always wins.
    if [ -z "${BU_NAME:-}" ]; then
      _tail="${HORSE_SESSION##*-}"
      [ "${#_tail}" -gt 12 ] && _tail="$(printf '%s' "$_tail" | tail -c 12)"
      export BU_NAME="hb-${_tail}${LANE:+-$LANE}"
    fi
  fi

  if [ -n "$script" ]; then
    exec "$HARNESS_PY" -m horse_harness.run "$@" <<<"$script"   # feed the captured heredoc as stdin
  else
    exec "$HARNESS_PY" -m horse_harness.run "$@"                # args only (e.g. --doctor) — inherit stdin
  fi
fi

exit 0
