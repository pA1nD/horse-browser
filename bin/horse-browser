#!/usr/bin/env bash
# horse-browser — ensure the dedicated agent browser is running.
#
# Idempotent: no-op if CDP is already up on the port; otherwise launches the
# browser (dedicated profile + tab-grouper extension) and BLOCKS until CDP is
# ready. So callers can run this and then immediately drive the browser.
#
# Config is written by install.sh to ~/.config/horse-browser/config. Env vars
# override it: HORSE_BROWSER_BIN, HORSE_BROWSER_PORT, HORSE_BROWSER_PROFILE.
set -euo pipefail

CONFIG="$HOME/.config/horse-browser/config"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

PORT="${HORSE_BROWSER_PORT:-${PORT:-9223}}"
PROFILE="${HORSE_BROWSER_PROFILE:-${PROFILE:-$HOME/.config/horse-browser/profile}}"
BIN="${HORSE_BROWSER_BIN:-${BROWSER_BIN:-}}"
EXT="${EXTENSION_DIR:-}"

cdp_up() { curl -sf "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }

if cdp_up; then
  echo "horse-browser: already up on :$PORT"
  exit 0
fi

if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
  echo "horse-browser: no browser configured (BROWSER_BIN missing or not executable)." >&2
  echo "  Run the repo's ./install.sh first, or set HORSE_BROWSER_BIN." >&2
  exit 1
fi

# Pin the extension's toolbar button. Pinned state lives in the profile's
# Preferences (extensions.pinned_extensions); Chrome owns that file, so we only touch it
# here — while the browser is stopped. The unpacked extension's id is a hash of
# its absolute path, so we compute it rather than hardcode. Creates Preferences
# if absent, so a first install is pinned too. (Re-pins each launch by design.)
if [ -n "$EXT" ] && command -v python3 >/dev/null 2>&1; then
  python3 - "$PROFILE/Default/Preferences" "$EXT" <<'PY' || true
import hashlib, json, os, sys
pref, ext = sys.argv[1], sys.argv[2]
eid = "".join(chr(ord("a") + int(c, 16)) for c in hashlib.sha256(ext.encode()).hexdigest()[:32])
os.makedirs(os.path.dirname(pref), exist_ok=True)
d = {}
if os.path.exists(pref):
    try: d = json.load(open(pref))
    except Exception: d = {}
tb = d.setdefault("extensions", {}).get("pinned_extensions")
if not isinstance(tb, list): tb = []
if eid not in tb: tb.append(eid)
d["extensions"]["pinned_extensions"] = tb
json.dump(d, open(pref, "w"))
PY
fi

args=( --remote-debugging-port="$PORT" --user-data-dir="$PROFILE"
       --test-type             # suppresses the "unsupported command-line flag" infobar
       --disable-infobars      # hides the Chrome-for-Testing infobar (per Playwright's chromiumSwitches)
       --remote-allow-origins=* # lets the in-browser Monitor page open the CDP socket (:9223)
       --no-first-run --no-default-browser-check )
[ -n "$EXT" ] && args+=( --load-extension="$EXT" )

"$BIN" "${args[@]}" >/dev/null 2>&1 &

echo "horse-browser: launching… (waiting for CDP :$PORT)"
for _ in $(seq 1 30); do
  cdp_up && { echo "horse-browser: ready on :$PORT"; exit 0; }
  sleep 1
done
echo "horse-browser: timed out waiting for CDP :$PORT — check the browser window." >&2
exit 1
